function loadGame() {
  try {
    const saved = JSON.parse(localStorage.getItem(STORAGE_KEY));
    if (!saved) return newGame();
    return {...newGame(),...saved};
  } catch(error) {
    console.warn("Spielstand konnte nicht geladen werden:",error);
    return newGame();
  }
}

