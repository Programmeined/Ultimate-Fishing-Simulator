<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ultimate Fishing Simulator</title>
<style>
:root {
  --bg: #101a1c;
  --panel: rgba(13, 27, 29, .94);
  --panel2: #1b3030;
  --green: #a4c69a;
  --gold: #e5bd70;
  --muted: #a8b8b0;
  --line: rgba(210,235,220,.14);
  --danger: #e17e70;
}
* { box-sizing:border-box; }
body {
  margin:0;
  color:#edf3ed;
  background:var(--bg);
  font-family:Inter,Segoe UI,Arial,sans-serif;
  min-height:100vh;
}
button,select,input { font:inherit; }
button {
  border:1px solid var(--line);
  background:#29413b;
  color:#f4f7f0;
  padding:10px 14px;
  border-radius:8px;
  cursor:pointer;
  transition:.2s;
}
button:hover { background:#3c5b4d; border-color:#9cbd9a; }
button:disabled { opacity:.4; cursor:not-allowed; }
button.primary { background:#678b64; color:#07120c; font-weight:700; }
button.gold { background:#b38b4f; color:#1b160c; font-weight:700; }
button.danger { background:#733e38; }
button.small { padding:6px 9px; font-size:12px; }
select,input {
  background:#142522;
  color:#fff;
  border:1px solid var(--line);
  padding:9px;
  border-radius:7px;
  width:100%;
}
header {
  height:68px;
  padding:0 22px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  background:#0b1415;
  border-bottom:1px solid var(--line);
  position:sticky;
  top:0;
  z-index:10;
}
.brand { font-weight:800; letter-spacing:1.5px; }
.brand span { color:var(--gold); }
.header-stats { display:flex; gap:18px; color:var(--muted); font-size:13px; }
.header-stats strong { color:#fff; }
.app {
  display:grid;
  grid-template-columns:220px minmax(0,1fr);
  min-height:calc(100vh - 68px);
}
nav {
  padding:18px 12px;
  background:#101c1c;
  border-right:1px solid var(--line);
}
.nav-label {
  color:#71877e;
  font-size:10px;
  letter-spacing:2px;
  margin:15px 10px 8px;
}
nav button {
  width:100%;
  text-align:left;
  margin:3px 0;
  background:transparent;
  border-color:transparent;
}
nav button.active { background:#294039; border-color:#486858; }
main { min-width:0; padding:22px; }
.page { display:none; }
.page.active { display:block; }
h1,h2,h3 { margin-top:0; }
h1 { font-size:25px; letter-spacing:.4px; }
h2 { font-size:19px; }
h3 { font-size:15px; }
.muted { color:var(--muted); }
.gold-text { color:var(--gold); }
.grid {
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:14px;
}
.card {
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:12px;
  padding:16px;
  min-width:0;
}
.card h3 { margin-bottom:8px; }
.stat {
  font-size:25px;
  font-weight:750;
  margin:7px 0;
}
.tag {
  display:inline-block;
  font-size:11px;
  padding:4px 8px;
  border-radius:20px;
  background:#2c453b;
  color:#c7dfc0;
}
hr { border:0; border-top:1px solid var(--line); margin:16px 0; }
.row { display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
.between { justify-content:space-between; }
.progress {
  height:8px;
  background:#0a1412;
  border-radius:10px;
  overflow:hidden;
}
.progress > div {
  height:100%;
  background:linear-gradient(90deg,#759b6e,#c1d49a);
  width:0%;
  transition:width .3s;
}
#world {
  height:440px;
  border-radius:14px;
  overflow:hidden;
  position:relative;
  border:1px solid #61766c;
  background:
    linear-gradient(180deg,rgba(17,32,39,.05),rgba(4,16,17,.25)),
    linear-gradient(180deg,#9aaea5 0%,#647e76 25%,#315c59 26%,#1c4847 60%,#173b36 100%);
}
#world::before {
  content:"";
  position:absolute;
  left:-5%; right:-5%; top:18%;
  height:24%;
  background:
    radial-gradient(ellipse at 20% 70%,#304b37 0 16%,transparent 17%),
    radial-gradient(ellipse at 45% 80%,#40583b 0 19%,transparent 20%),
    radial-gradient(ellipse at 78% 60%,#2d4935 0 20%,transparent 21%);
  filter:blur(2px);
}
#world::after {
  content:"";
  position:absolute;
  left:0; right:0; top:26%;
  height:4px;
  background:rgba(215,230,205,.25);
  box-shadow:0 20px 30px rgba(210,240,230,.1);
}
.sun {
  position:absolute;
  width:65px; height:65px;
  border-radius:50%;
  top:8%; right:18%;
  background:#e8d7a4;
  box-shadow:0 0 55px 18px rgba(238,220,158,.2);
}
.water {
  position:absolute;
  left:0; right:0; top:28%; bottom:0;
  background:
    repeating-linear-gradient(174deg,transparent 0 18px,rgba(195,221,208,.08) 19px 20px,transparent 21px 38px),
    linear-gradient(180deg,rgba(44,99,94,.8),rgba(8,43,42,.95));
  animation:waterMove 8s linear infinite;
}
@keyframes waterMove {
  from { background-position:0 0,0 0; }
  to { background-position:120px 0,0 0; }
}
.reeds {
  position:absolute; bottom:0; left:4%;
  color:#b1b887; font-size:54px; opacity:.65;
}
#float {
  display:none;
  position:absolute;
  width:12px; height:22px;
  border-radius:50% 50% 40% 40%;
  background:#e5bd70;
  border:2px solid #f6e4ba;
  left:58%; top:56%;
  z-index:3;
  box-shadow:0 0 10px rgba(255,255,255,.3);
}
#castLine {
  display:none;
  position:absolute;
  height:1px;
  width:38%;
  left:21%; top:54%;
  transform:rotate(7deg);
  transform-origin:left;
  background:rgba(235,241,221,.65);
  z-index:2;
}
#world.weather-rain .water {
  background-image:repeating-linear-gradient(100deg,transparent 0 7px,rgba(220,240,240,.2) 8px 9px,transparent 10px 17px);
}
#world.night { filter:brightness(.45) saturate(.8); }
#world.fog::before { filter:blur(12px); opacity:.6; }
#biteAlert {
  display:none;
  position:absolute;
  z-index:5;
  top:16px; left:50%;
  transform:translateX(-50%);
  padding:12px 20px;
  border-radius:9px;
  color:#1b160c;
  background:#f1c56e;
  font-weight:800;
  animation:pulse .7s infinite alternate;
}
@keyframes pulse { to { transform:translateX(-50%) scale(1.06); } }
.hud {
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:8px;
  margin-top:12px;
}
.hud .card { padding:11px; }
.hud .stat { font-size:17px; }
.control-panel { margin-top:14px; }
.control-panel button { margin:3px; }
.meter {
  height:12px;
  background:#0b1513;
  border-radius:20px;
  overflow:hidden;
  margin:6px 0 12px;
}
.meter div { height:100%; width:0; transition:width .15s; }
#tensionBar { background:#d59b58; }
#staminaBar { background:#79ad75; }
#catchList { display:grid; gap:8px; }
.catch-item {
  display:flex; justify-content:space-between;
  padding:10px; border-radius:8px;
  background:#192b28; font-size:13px;
}
.shop-item,.mission-item {
  display:flex; align-items:center; justify-content:space-between;
  gap:12px; padding:12px 0; border-bottom:1px solid var(--line);
}
.shop-item:last-child,.mission-item:last-child { border:0; }
.toast {
  position:fixed; bottom:22px; right:22px;
  background:#e2c17d; color:#17150e;
  padding:13px 18px; border-radius:9px;
  font-weight:700; z-index:30;
  opacity:0; transform:translateY(10px);
  pointer-events:none; transition:.25s;
}
.toast.show { opacity:1; transform:translateY(0); }
.modal-backdrop {
  display:none; position:fixed; inset:0; z-index:20;
  background:rgba(0,0,0,.7);
  align-items:center; justify-content:center; padding:18px;
}
.modal-backdrop.show { display:flex; }
.modal {
  width:min(520px,100%);
  background:#142321; border:1px solid var(--line);
  border-radius:14px; padding:22px;
}
.empty { color:#82958c; padding:18px 0; }
footer { color:#73877e; font-size:11px; margin-top:25px; }
@media(max-width:760px) {
  header { padding:0 12px; }
  .header-stats { gap:8px; font-size:11px; }
  .app { grid-template-columns:1fr; }
  nav {
    display:flex; overflow-x:auto; gap:5px;
    border-right:0; border-bottom:1px solid var(--line);
    padding:8px;
  }
  nav .nav-label { display:none; }
  nav button { width:auto; white-space:nowrap; font-size:12px; }
  main { padding:14px; }
  #world { height:330px; }
  .hud { grid-template-columns:repeat(2,1fr); }
}
</style>
</head>
<body>
<header>
  <div class="brand">ULTIMATE <span>FISHING</span> SIMULATOR</div>
  <div class="header-stats">
    <span>LEVEL <strong id="headerLevel">1</strong></span>
    <span>XP <strong id="headerXP">0</strong></span>
    <span>GELD <strong id="headerMoney">250 €</strong></span>
  </div>
</header>

<div class="app">
<nav>
  <div class="nav-label">SPIEL</div>
  <button class="active" data-page="fishing">🎣 Angeln</button>
  <button data-page="locations">🌲 Angelgebiete</button>
  <button data-page="equipment">🧰 Ausrüstung</button>
  <button data-page="shop">🛒 Shop</button>
  <div class="nav-label">FORTSCHRITT</div>
  <button data-page="missions">📋 Missionen</button>
  <button data-page="logbook">📖 Fangbuch</button>
  <button data-page="records">🏆 Rekorde</button>
  <button data-page="encyclopedia">🐟 Fischlexikon</button>
  <div class="nav-label">WEITERE</div>
  <button data-page="tournaments">🥇 Turniere</button>
  <button data-page="settings">⚙️ Einstellungen</button>
</nav>

<main>
<section class="page active" id="page-fishing">
  <div class="row between">
    <div>
      <h1 id="locationTitle">Waldsee</h1>
      <p class="muted" id="locationDescription">Ein stiller See, umgeben von dichtem Wald.</p>
    </div>
    <span class="tag" id="eventTag">Ruhiger Angeltag</span>
  </div>

  <div id="world">
    <div class="sun"></div>
    <div class="water"></div>
    <div class="reeds">♧ ♧ ♧</div>
    <div id="castLine"></div>
    <div id="float"></div>
    <div id="biteAlert">BISS! JETZT ANSCHLAGEN!</div>
  </div>

  <div class="hud">
    <div class="card"><div class="muted">Uhrzeit</div><div class="stat" id="clock">07:30</div></div>
    <div class="card"><div class="muted">Wetter</div><div class="stat" id="weather">☀️ Sonnig</div></div>
    <div class="card"><div class="muted">Temperatur</div><div class="stat" id="temperature">18 °C</div></div>
    <div class="card"><div class="muted">Wind</div><div class="stat" id="wind">5 km/h</div></div>
  </div>

  <div class="grid control-panel">
    <div class="card">
      <h3>Angel vorbereiten</h3>
      <label class="muted">Angelrute</label>
      <select id="rodSelect"></select>
      <label class="muted">Köder</label>
      <select id="baitSelect"></select>
      <label class="muted">Angeltiefe</label>
      <select id="depthSelect">
        <option value="shallow">Flach (0,5–1 m)</option>
        <option value="mid" selected>Mittel (1–3 m)</option>
        <option value="deep">Tief (3–7 m)</option>
      </select>
      <label class="muted">Wurfweite</label>
      <input id="distanceInput" type="range" min="10" max="80" value="45">
      <div class="row between"><small class="muted">10 m</small><strong id="distanceValue">45 m</strong><small class="muted">80 m</small></div>
      <button class="primary" id="castButton">Auswerfen</button>
      <button id="reelButton" disabled>Einholen</button>
    </div>

    <div class="card">
      <h3>Drill-Kontrolle</h3>
      <div class="muted">Schnurspannung</div>
      <div class="meter"><div id="tensionBar"></div></div>
      <div class="muted">Fisch-Ausdauer</div>
      <div class="meter"><div id="staminaBar"></div></div>
      <div class="row between">
        <span class="muted">Bremskraft</span>
        <strong id="brakeValue">45 %</strong>
      </div>
      <input id="brakeInput" type="range" min="10" max="90" value="45">
      <div class="row">
        <button id="reelInButton" disabled>Kurbeln</button>
        <button id="releaseButton" disabled>Fisch landen</button>
      </div>
      <p class="muted" id="fishingStatus">Wähle deine Ausrüstung und wirf aus.</p>
    </div>

    <div class="card">
      <h3>Angelplatz-Analyse</h3>
      <p class="muted" id="analysisText">Wähle einen Angelplatz, um die Bedingungen zu analysieren.</p>
      <div class="row between"><span class="muted">Fischaktivität</span><strong id="activityText">Mittel</strong></div>
      <div class="progress"><div id="activityBar" style="width:55%"></div></div>
      <button id="scannerButton">Echolot scannen</button>
      <button id="underwaterButton">Unterwasserblick</button>
    </div>
  </div>
</section>

<section class="page" id="page-locations">
  <h1>Angelgebiete</h1>
  <p class="muted">Erkunde unterschiedliche Gewässer und ihre Fischbestände.</p>
  <div class="grid" id="locationCards"></div>
</section>

<section class="page" id="page-equipment">
  <h1>Meine Ausrüstung</h1>
  <div class="grid">
    <div class="card"><h3>Aktuelle Angel</h3><div id="equippedRod"></div></div>
    <div class="card"><h3>Aktueller Köder</h3><div id="equippedBait"></div></div>
    <div class="card"><h3>Schnur</h3><div id="lineInfo">Monofile Schnur · 6 kg Tragkraft</div></div>
    <div class="card"><h3>Zubehör</h3><div id="accessoryInfo">Einfacher Kescher</div></div>
  </div>
</section>

<section class="page" id="page-shop">
  <h1>Ausrüstungsshop</h1>
  <p class="muted">Verbessere deine Ausrüstung mit verdientem Spielgeld.</p>
  <div class="card" id="shopList"></div>
</section>

<section class="page" id="page-missions">
  <h1>Missionen</h1>
  <div class="grid">
    <div class="card"><h2>Tägliche Aufgaben</h2><div id="dailyMissions"></div></div>
    <div class="card"><h2>Wochenaufgaben</h2><div id="weeklyMissions"></div></div>
  </div>
</section>

<section class="page" id="page-logbook">
  <h1>Persönliches Fangbuch</h1>
  <div class="grid">
    <div class="card"><h3>Gesamtfänge</h3><div class="stat" id="totalCatches">0</div></div>
    <div class="card"><h3>Gesamtgewicht</h3><div class="stat" id="totalWeight">0 kg</div></div>
    <div class="card"><h3>Arten entdeckt</h3><div class="stat" id="speciesCount">0</div></div>
  </div>
  <div class="card" style="margin-top:14px">
    <h2>Letzte Fänge</h2>
    <div id="catchList"><div class="empty">Noch keine Fische gefangen.</div></div>
  </div>
</section>

<section class="page" id="page-records">
  <h1>Rekorde und Trophäen</h1>
  <div class="grid" id="recordCards"></div>
</section>

<section class="page" id="page-encyclopedia">
  <h1>Fischlexikon</h1>
  <p class="muted">Entdecke Lebensräume, Nahrung und bevorzugte Köder.</p>
  <div class="grid" id="fishCards"></div>
</section>

<section class="page" id="page-tournaments">
  <h1>Turniere</h1>
  <div class="grid" id="tournamentCards"></div>
</section>

<section class="page" id="page-settings">
  <h1>Einstellungen und Spielstand</h1>
  <div class="card">
    <h3>Spielverwaltung</h3>
    <p class="muted">Dein Fortschritt wird automatisch im Browser gespeichert.</p>
    <button id="saveButton" class="primary">Jetzt speichern</button>
    <button id="resetButton" class="danger">Spielstand zurücksetzen</button>
    <hr>
    <label for="soundVolume">Soundlautstärke</label>
    <input id="soundVolume" type="range" min="0" max="100" value="35">
    <p class="muted">Soundeffekte werden nach deiner ersten Interaktion aktiviert.</p>
  </div>
</section>

<footer>ULTIMATE FISHING SIMULATOR · REAL LIFE FISHING EXPERIENCE</footer>
</main>
</div>

<div class="toast" id="toast"></div>
<div class="modal-backdrop" id="modalBackdrop">
  <div class="modal">
    <div class="row between">
      <h2 id="modalTitle">Information</h2>
      <button id="closeModal">✕</button>
    </div>
    <div id="modalContent"></div>
  </div>
</div>
