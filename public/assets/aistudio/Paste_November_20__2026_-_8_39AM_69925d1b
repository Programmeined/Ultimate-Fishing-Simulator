function getWeekKey() {
  const d = new Date();
  const first = new Date(d.getFullYear(),0,1);
  return `${d.getFullYear()}-${Math.ceil((((d-first)/86400000)+first.getDay()+1)/7)}`;
}

function currentLocation() {
  return locations.find(x=>x.id===state.location) || locations[0];
}

function currentRod() {
  return rods.find(x=>x.name===state.currentRod) || rods[0];
