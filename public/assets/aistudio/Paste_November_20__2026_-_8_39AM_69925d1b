function notify(message) {
  const toast=$("toast");
  toast.textContent=message;
  toast.classList.add("show");
  clearTimeout(notify.timer);
  notify.timer=setTimeout(()=>toast.classList.remove("show"),2600);
}

function showModal(title,html) {
  $("modalTitle").textContent=title;
  $("modalContent").innerHTML=html;
  $("modalBackdrop").classList.add("show");
}

function closeModal() {
  $("modalBackdrop").classList.remove("show");
}

function addXP(amount) {
  state.xp+=amount;
  let needed=state.level*120;
  while(state.xp>=needed) {
    state.xp-=needed;
    state.level++;
    needed=state.level*120;
    notify(`Levelaufstieg! Du bist jetzt Level ${state.level}.`);
    if(state.level>=5 && !state.unlocked.includes("karpfensee")) {
      state.unlocked.push("karpfensee");
    }
  }
  saveGame();
  updateHeader();
}

function updateHeader() {
  $("headerLevel").textContent=state.level;
  $("headerXP").textContent=state.xp;
  $("headerMoney").textContent=state.money+" €";
}

function getTimeLabel() {
  const h=Math.floor(gameTime)%24;
  const m=Math.floor((gameTime%1)*60/5)*5;
  return `${String(h).padStart(2,"0")}:${String(m).padStart(2,"0")}`;
}

function getDayPhase() {
  const h=gameTime%24;
  if(h>=5&&h<8) return "Morgen";
  if(h>=8&&h<17) return "Tag";
  if(h>=17&&h<21) return "Abend";
  return "Nacht";
}

function activityLevel() {
  let value=48;
  const phase=getDayPhase();
  if(phase==="Morgen"||phase==="Abend") value+=18;
  if(phase==="Nacht") value-=5;
  if(weather==="Leichter Regen") value+=10;
  if(weather==="Starker Regen") value-=8;
  if(weather==="Nebel") value+=5;
  return Math.max(10,Math.min(95,value+Math.random()*8));
}

function updateWorld() {
  const phase=getDayPhase();
  $("clock").textContent=getTimeLabel();
  $("weather").textContent=({
    "Sonnig":"☀️ Sonnig",
    "Bewölkt":"☁️ Bewölkt",
    "Leichter Regen":"🌦️ Regen",
    "Starker Regen":"🌧️ Starkregen",
    "Nebel":"🌫️ Nebel",
    "Windig":"💨 Windig"
  })[weather]||weather;
  $("temperature").textContent=temperature+" °C";
  $("wind").textContent=wind+" km/h";

  $("world").classList.toggle("night",phase==="Nacht");
  $("world").classList.toggle("fog",weather==="Nebel");
  $("world").classList.toggle("weather-rain",weather.includes("Regen"));

  const active=activityLevel();
  $("activityText").textContent=active>70?"Hoch":active>42?"Mittel":"Niedrig";
  $("activityBar").style.width=active+"%";

  const loc=currentLocation();
  $("analysisText").textContent=
    `Tiefe: ${loc.depth} m · Boden: ${loc.bottom} · Pflanzen: ${loc.plants} · Gewässer: ${loc.kind}.`;
}

function changeWeather() {
  const options=["Sonnig","Bewölkt","Leichter Regen","Starker Regen","Nebel","Windig"];
  weather=options[Math.floor(Math.random()*options.length)];
  temperature=Math.round(12+Math.random()*14);
  wind=Math.round(2+Math.random()*25);
  updateWorld();
}

function tickWorld() {
  gameTime=(gameTime+0.025)%24;
  weatherTimer++;
  if(weatherTimer>120) {
    weatherTimer=0;
    if(Math.random()<.35) changeWeather();
  }
  updateWorld();
}

