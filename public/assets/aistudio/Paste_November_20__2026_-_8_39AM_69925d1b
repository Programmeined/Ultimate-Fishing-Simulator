function buyItem(name) {
  const item=shopItems.find(x=>x.name===name);
  if(!item||state.money<item.price) return notify("Dafür hast du nicht genug Geld.");
  if(item.kind==="rod") {
    const rod=rods.find(x=>x.name===name);
    if(!rod||state.level<rod.level) return notify("Dein Level reicht noch nicht.");
    if(state.ownedRods.includes(name)) return;
    state.ownedRods.push(name);
  } else {
    if(state.gear.includes(name)) return;
    state.gear.push(name);
  }
  state.money-=item.price;
  saveGame();
  updateHeader();
  renderShop();
  notify(`${name} gekauft!`);
}

function buyBait(name) {
  const bait=baits.find(x=>x.name===name);
  if(!bait||state.money<bait.price*10) return notify("Nicht genug Geld.");
  state.money-=bait.price*10;
  state.baits[name]=(state.baits[name]||0)+10;
  saveGame();
  updateHeader();
  populateEquipmentSelectors();
  renderShop();
  notify(`10 × ${name} gekauft.`);
}

/* =========================================================
   Auswerfen und Biss-System
========================================================= */

function castLine() {
  if(fishing.phase!=="idle") return notify("Deine Angel ist bereits im Wasser.");
  const bait=state.currentBait;
  if(!state.baits[bait]||state.baits[bait]<=0) return notify("Du hast diesen Köder nicht mehr.");
  if(!state.ownedRods.includes(state.currentRod)) return notify("Diese Angel ist nicht verfügbar.");

  state.baits[bait]--;
  fishing.phase="waiting";
  fishing.distance=Number($("distanceInput").value);
  $("float").style.display="block";
  $("castLine").style.display="block";
  $("castButton").disabled=true;
  $("reelButton").disabled=false;
  $("fishingStatus").textContent="Der Köder liegt im Wasser. Warte auf einen Biss …";
  saveGame();
  populateEquipmentSelectors();
  playTone(180,.08);
  notify("Ausgeworfen! Jetzt aufmerksam bleiben.");

  const wait=7000+Math.random()*15000;
  fishing.biteTimeout=setTimeout(triggerBite,wait);
}

function getEligibleFish() {
  const loc=currentLocation();
  const bait=state.currentBait;
  const depth=$("depthSelect").value;
  const phase=getDayPhase();
  let candidates=fishData.filter(f=>loc.fish.includes(f.name));
  candidates=candidates.filter(f=>f.depth.includes(depth));
  if(candidates.length===0) candidates=fishData.filter(f=>loc.fish.includes(f.name));
  const weighted=[];
  candidates.forEach(f=>{
    let score=1/(f.rarity||1);
    if(f.baits.includes(bait)) score*=3.5;
    if(f.times.includes(phase)) score*=1.7;
    if(weather.includes("Regen")&&f.type==="Friedfisch") score*=1.15;
    for(let i=0;i<Math.max(1,Math.round(score*5));i++) weighted.push(f);
  });
  return weighted[Math.floor(Math.random()*weighted.length)]||candidates[0];
}

function triggerBite() {
  if(fishing.phase!=="waiting") return;
  fishing.fish=getEligibleFish();
  fishing.phase="bite";
  $("biteAlert").style.display="block";
  $("fishingStatus").textContent="Ein Fisch hat angebissen! Jetzt anschlagen!";
  playTone(650,.18);
  fishing.biteTimeout=setTimeout(()=>{
    if(fishing.phase==="bite") {
      notify("Der Fisch hat den Köder wieder losgelassen.");
      resetFishing();
    }
  },3500);
}

function strike() {
  if(fishing.phase!=="bite") return;
  clearTimeout(fishing.biteTimeout);
  $("biteAlert").style.display="none";
  fishing.phase="fight";
  const f=fishing.fish;
  const weight=f.weight[0]+Math.random()*(f.weight[1]-f.weight[0]);
  const length=f.length[0]+Math.random()*(f.length[1]-f.length[0]);
  fishing.fish={...f,caughtWeight:weight,caughtLength:length};
  fishing.stamina=100;
  fishing.tension=25;
  fishing.distance=12+Math.random()*35;
  fishing.lastTick=Date.now();
  $("reelInButton").disabled=false;
  $("releaseButton").disabled=false;
  $("fishingStatus").textContent=`${f.name} am Haken! Halte die Spannung im grünen Bereich.`;
  notify(`${f.name} hat angebissen! Der Drill beginnt.`);
  playTone(420,.15);
  startFightLoop();
}

function startFightLoop() {
  clearInterval(fishing.timer);
  fishing.timer=setInterval(()=>{
    if(fishing.phase!=="fight") return;
    const f=fishing.fish;
    const rodPower=currentRod().power;
    const brake=Number($("brakeInput").value);
    const force=(f.caughtWeight*1.3)+Math.random()*15;
    const pressure=brake*.55+rodPower*.9;
    const delta=force-pressure;
    fishing.tension=Math.max(0,Math.min(100,fishing.tension+delta*.16));
    fishing.stamina=Math.max(0,fishing.stamina-(Math.max(0,pressure-force*.55)*.08));
    if(Math.random()<.25) fishing.distance=Math.min(90,fishing.distance+Math.random()*2.5);
    updateFightUI();

    if(fishing.tension>95) {
      notify("Die Schnur ist gerissen! Der Fisch entkommt.");
      resetFishing();
    } else if(fishing.distance>85) {
      notify("Der Fisch ist entkommen.");
      resetFishing();
    } else if(fishing.stamina<=0) {
      fishing.distance=Math.max(0,fishing.distance-1);
      $("fishingStatus").textContent="Der Fisch ist ermüdet. Du kannst ihn landen.";
    }
  },500);
}

function updateFightUI() {
  $("tensionBar").style.width=fishing.tension+"%";
  $("staminaBar").style.width=fishing.stamina+"%";
  $("brakeValue").textContent=$("brakeInput").value+" %";
  $("fishingStatus").textContent=
    `Fisch: ${fishing.fish.name} · Entfernung: ${Math.round(fishing.distance)} m · Spannung: ${Math.round(fishing.tension)} %`;
}

function reelIn() {
  if(fishing.phase!=="fight") return;
  const brake=Number($("brakeInput").value);
  const rodPower=currentRod().power;
  fishing.tension+=Math.max(1,brake*.035);
  fishing.distance-=Math.max(.7,rodPower*.12);
  fishing.stamina=Math.max(0,fishing.stamina-1.8);
  if(fishing.tension>95) {
    notify("Zu viel Druck! Die Schnur ist gerissen.");
    resetFishing();
    return;
  }
  updateFightUI();
  if(fishing.distance<=2&&fishing.stamina<=15) landFish();
}

function landFish() {
  if(fishing.phase!=="fight") return;
  const fish=fishing.fish;
  if(!fish) return;
  clearInterval(fishing.timer);
  const entry={
    name:fish.name,
    weight:Number(fish.caughtWeight.toFixed(2)),
    length:Number(fish.caughtLength.toFixed(1)),
    location:currentLocation().name,
    bait:state.currentBait,
    rod:state.currentRod,
    date:new Date().toLocaleString("de-DE"),
    released:false
  };
  state.catches.unshift(entry);
  state.totalCaught++;
  state.totalWeight+=entry.weight;
  const value=Math.max(2,Math.round(entry.weight*4+entry.length*.12));
  state.money+=value;
  addXP(Math.round(15+entry.weight*2));
  updateRecords(entry);
  updateMissionProgress(entry);
  saveGame();
  notify(`${entry.name} gelandet! ${entry.weight} kg · Verkauf: ${value} €`);
  showCatchModal(entry,value);
  resetFishing();
  updateHeader();
}

function showCatchModal(fish,value) {
  showModal("Fang erfolgreich!",`
    <div class="card">
      <div class="tag">NEUER FANG</div>
      <h2>🐟 ${fish.name}</h2>
      <p>Gewicht: <strong>${fish.weight} kg</strong></p>
      <p>Länge: <strong>${fish.length} cm</strong></p>
      <p>Angelgebiet: ${fish.location}</p>
      <p>Köder: ${fish.bait}</p>
      <p>Verkaufserlös: <strong>${value} €</strong></p>
    </div>
    <p>Du kannst den Fang behalten oder ihn im Fangbuch dokumentieren und zurücksetzen.</p>
    <button class="primary" onclick="keepCatch()">Behalten und verkaufen</button>
    <button onclick="releaseCatch()">Catch & Release (+XP)</button>
  `);
  fishing.pendingCatch=fish;
}

function keepCatch() {
  closeModal();
  saveGame();
  resetFishing();
  notify("Fang wurde verkauft und gespeichert.");
  renderLogbook();
}

function releaseCatch() {
  const fish=fishing.pendingCatch;
  if(!fish) return closeModal();
  const found=state.catches.find(x=>x.date===fish.date);
  if(found) found.released=true;
  state.money=Math.max(0,state.money-Math.max(2,Math.round(fish.weight*4+fish.length*.12)));
  state.released++;
  addXP(20);
  fishing.pendingCatch=null;
  closeModal();
  saveGame();
  resetFishing();
  notify("Fisch schonend zurückgesetzt. +20 XP");
  renderLogbook();
}

function resetFishing() {
  clearInterval(fishing.timer);
  clearTimeout(fishing.biteTimeout);
  fishing.phase="idle";
  fishing.fish=null;
  fishing.tension=0;
  fishing.stamina=0;
  fishing.distance=0;
  $("float").style.display="none";
  $("castLine").style.display="none";
  $("biteAlert").style.display="none";
  $("castButton").disabled=false;
  $("reelButton").disabled=true;
  $("reelInButton").disabled=true;
  $("releaseButton").disabled=true;
  $("tensionBar").style.width="0%";
  $("staminaBar").style.width="0%";
  $("fishingStatus").textContent="Wähle deine Ausrüstung und wirf aus.";
}

function updateRecords(fish) {
  const heaviest=state.records.heaviest;
  if(!heaviest||fish.weight>heaviest.weight) state.records.heaviest=fish;
  if(fish.name.toLowerCase().includes("karpfen")) {
    if(!state.records.carp||fish.weight>state.records.carp.weight) state.records.carp=fish;
  }
  if(fish.name==="Hecht") {
    if(!state.records.pike||fish.length>state.records.pike.length) state.records.pike=fish;
  }
  if(!state.records.longest||fish.length>state.records.longest.length) state.records.longest=fish;
}

/* =========================================================
   Audio: einfache synthetische Soundeffekte
========================================================= */

function playTone(frequency=440,duration=.1) {
  if(Number(state.sound)===0) return;
  try {
    soundContext=soundContext||new (window.AudioContext||window.webkitAudioContext)();
    const oscillator=soundContext.createOscillator();
    const gain=soundContext.createGain();
    oscillator.frequency.value=frequency;
    gain.gain.value=(state.sound/100)*.045;
    oscillator.connect(gain);
    gain.connect(soundContext.destination);
    oscillator.start();
    gain.gain.exponentialRampToValueAtTime(.001,soundContext.currentTime+duration);
    oscillator.stop(soundContext.currentTime+duration);
  } catch(e) {
    console.warn("Audio nicht verfügbar",e);
  }
}

/* =========================================================
   Buttons und Steuerung
========================================================= */

document.querySelectorAll("nav button").forEach(button=>{
  button.addEventListener("click",()=>showPage(button.dataset.page));
});

$("castButton").addEventListener("click",castLine);
$("reelButton").addEventListener("click",()=>{
  if(fishing.phase==="bite") strike();
  else if(fishing.phase==="waiting") {
    clearTimeout(fishing.biteTimeout);
    resetFishing();
    notify("Du hast die Angel eingeholt.");
  }
});
$("reelInButton").addEventListener("click",reelIn);
$("releaseButton").addEventListener("click",landFish);
$("brakeInput").addEventListener("input",()=>{
  $("brakeValue").textContent=$("brakeInput").value+" %";
});
$("distanceInput").addEventListener("input",()=>{
  $("distanceValue").textContent=$("distanceInput").value+" m";
});
$("rodSelect").addEventListener("change",e=>{
  state.currentRod=e.target.value;
  saveGame();
  renderEquipment();
});
$("baitSelect").addEventListener("change",e=>{
  state.currentBait=e.target.value;
  saveGame();
  renderEquipment();
});
$("closeModal").addEventListener("click",closeModal);
$("modalBackdrop").addEventListener("click",e=>{
  if(e.target===$("modalBackdrop")) closeModal();
});
$("saveButton").addEventListener("click",()=>{
  saveGame();
  notify("Spielstand gespeichert.");
});
$("resetButton").addEventListener("click",()=>{
  if(confirm("Wirklich den gesamten Spielstand löschen?")) {
    localStorage.removeItem(STORAGE_KEY);
    location.reload();
  }
});
$("soundVolume").addEventListener("input",e=>{
  state.sound=Number(e.target.value);
  saveGame();
});
$("scannerButton").addEventListener("click",()=>{
  const loc=currentLocation();
  const fish=loc.fish.filter(()=>Math.random()>.35);
  showModal("Echolot-Analyse",`
    <p><strong>Gewässer:</strong> ${loc.name}</p>
    <p><strong>Tiefe:</strong> ${loc.depth} m</p>
    <p><strong>Boden:</strong> ${loc.bottom}</p>
    <p><strong>Erkannte Fischarten:</strong> ${fish.join(", ")||"Keine eindeutigen Signale"}</p>
    <p class="muted">Die Anzeige ist eine simulierte Echolotmessung.</p>
  `);
});
$("underwaterButton").addEventListener("click",()=>{
  const fish=currentLocation().fish;
  showModal("Unterwasserkamera",`
    <div style="padding:25px;background:linear-gradient(#367a7b,#0a292e);border-radius:12px;text-align:center">
      <div style="font-size:42px">〰️ 🐟 〰️</div>
      <h3>Unterwasseransicht</h3>
      <p>Wassertiefe: ${currentLocation().depth} m</p>
      <p>Im Gebiet vorkommende Arten:</p>
      <strong>${fish.join(" · ")}</strong>
    </div>
  `);
});

/* =========================================================
   Initialisierung
========================================================= */

function initGame() {
  populateEquipmentSelectors();
  updateHeader();
  updateWorld();
  $("locationTitle").textContent=currentLocation().name;
  $("locationDescription").textContent=currentLocation().description;
  $("soundVolume").value=state.sound;
  renderPage("locations");
  renderPage("equipment");
  renderPage("shop");
  renderPage("missions");
  renderPage("logbook");
  renderPage("records");
  renderPage("encyclopedia");
  renderPage("tournaments");
  setInterval(tickWorld,1000);
  setInterval(saveGame,15000);
}

initGame();
</script>
<script>
/* =========================================================
   TÄGLICHE UND WÖCHENTLICHE MISSIONEN
========================================================= */

const dailyTemplates = [
  {id:"catch3",name:"Kleiner Angeltag",description:"Fange 3 Fische.",target:3,reward:80,xp:35,progress:0},
  {id:"carp",name:"Karpfenjäger",description:"Fange einen Karpfen.",target:1,reward:120,xp:50,progress:0},
  {id:"bigfish",name:"Schöner Fang",description:"Fange einen Fisch über 2 kg.",target:1,reward:100,xp:45,progress:0},
  {id:"species",name:"Artenvielfalt",description:"Fange 2 unterschiedliche Fischarten.",target:2,reward:110,xp:45,progress:0},
  {id:"predator",name:"Räuber des Wassers",description:"Fange einen Raubfisch.",target:1,reward:90,xp:40,progress:0}
];

const weeklyTemplates = [
  {id:"week10",name:"Fleißiger Angler",description:"Fange 10 Fische.",target:10,reward:400,xp:150,progress:0},
  {id:"weekweight",name:"Schwergewicht",description:"Erreiche 30 kg Gesamtfanggewicht.",target:30,reward:500,xp:180,progress:0},
  {id:"weekspecies",name:"Fischkenner",description:"Fange 5 verschiedene Fischarten.",target:5,reward:450,xp:160,progress:0}
];

function createMissions() {
  state.missions=dailyTemplates.slice(0,3).map(m=>({...m,progress:0,completed:false,claimed:false}));
  state.weekly=weeklyTemplates.map(m=>({...m,progress:0,completed:false,claimed:false}));
  state.lastDaily=new Date().toDateString();
  state.lastWeekly=getWeekKey();
  saveGame();
}

function checkMissionReset() {
  const today=new Date().toDateString();
  if(state.lastDaily!==today) createMissions();

  if(state.lastWeekly!==getWeekKey()) {
    state.weekly=weeklyTemplates.map(m=>({...m,progress:0,completed:false,claimed:false}));
    state.lastWeekly=getWeekKey();
    saveGame();
  }

  if(!state.missions||state.missions.length===0) createMissions();
  if(!state.weekly||state.weekly.length===0) {
    state.weekly=weeklyTemplates.map(m=>({...m,progress:0,completed:false,claimed:false}));
  }
}

function updateMissionProgress(fish) {
  checkMissionReset();

  function update(list) {
    list.forEach(m=>{
      if(m.completed) return;

      if(m.id==="catch3"||m.id==="week10") m.progress++;
      if(m.id==="carp"&&fish.name.toLowerCase().includes("karpfen")) m.progress++;
      if(m.id==="bigfish"&&fish.weight>=2) m.progress++;
      if(m.id==="species") {
        const distinct=new Set(state.catches.map(c=>c.name));
        m.progress=distinct.size;
      }
      if(m.id==="predator"&&fish.type==="Raubfisch") m.progress++;
      if(m.id==="weekweight") m.progress=Number(state.totalWeight.toFixed(1));
      if(m.id==="weekspecies") {
        m.progress=new Set(state.catches.map(c=>c.name)).size;
      }

      if(m.progress>=m.target) {
        m.progress=m.target;
        m.completed=true;
        notify(`Mission abgeschlossen: ${m.name}`);
      }
    });
  }

  update(state.missions);
  update(state.weekly);
  saveGame();
}

function claimMission(type,index) {
  const list=type==="daily"?state.missions:state.weekly;
  const mission=list[index];
  if(!mission||!mission.completed||mission.claimed) return;

  mission.claimed=true;
  state.money+=mission.reward;
  addXP(mission.xp);
  saveGame();
  updateHeader();
  renderMissions();
  notify(`Belohnung erhalten: ${mission.reward} € und ${mission.xp} XP`);
}

function renderMissionList(list,type) {
  return list.map((m,index)=>`
    <div class="mission-item">
      <div style="flex:1">
        <strong>${m.name}</strong>
        <p class="muted">${m.description}</p>
        <div class="progress"><div style="width:${Math.min(100,m.progress/m.target*100)}%"></div></div>
        <small class="muted">${m.progress}/${m.target} · Belohnung ${m.reward} € · ${m.xp} XP</small>
      </div>
      <div>
        ${m.claimed
          ? '<span class="tag">Erledigt</span>'
          : m.completed
            ? `<button class="small gold" onclick="claimMission('${type}',${index})">Abholen</button>`
            : '<span class="tag">Aktiv</span>'}
      </div>
    </div>
  `).join("");
}

function renderMissions() {
  checkMissionReset();
  $("dailyMissions").innerHTML=renderMissionList(state.missions,"daily");
  $("weeklyMissions").innerHTML=renderMissionList(state.weekly,"weekly");
}

/* =========================================================
   FANGBUCH
========================================================= */

function renderLogbook() {
  const catches=state.catches||[];
  $("totalCatches").textContent=state.totalCaught;
  $("totalWeight").textContent=state.totalWeight.toFixed(1)+" kg";
  $("speciesCount").textContent=new Set(catches.map(f=>f.name)).size;

  if(catches.length===0) {
    $("catchList").innerHTML='<div class="empty">Noch keine Fische gefangen. Wirf deine Angel aus!</div>';
    return;
  }

  $("catchList").innerHTML=catches.slice(0,60).map(f=>`
    <div class="catch-item">
      <div>
        <strong>🐟 ${f.name}</strong><br>
        <span class="muted">${f.location} · ${f.date}</span><br>
        <small class="muted">${f.bait} · ${f.rod}</small>
      </div>
      <div style="text-align:right">
        <strong>${f.weight} kg</strong><br>
        <span class="muted">${f.length} cm</span><br>
        ${f.released?'<span class="tag">Zurückgesetzt</span>':''}
      </div>
    </div>
  `).join("");
}

/* =========================================================
   REKORDE
========================================================= */

function renderRecords() {
  const records=[
    {title:"Schwerster Fisch",fish:state.records.heaviest,field:"weight",unit:"kg"},
    {title:"Längster Fisch",fish:state.records.longest,field:"length",unit:"cm"},
    {title:"Größter Karpfen",fish:state.records.carp,field:"weight",unit:"kg"},
    {title:"Längster Hecht",fish:state.records.pike,field:"length",unit:"cm"}
  ];

  $("recordCards").innerHTML=records.map(r=>`
    <div class="card">
      <span class="tag">PERSÖNLICHER REKORD</span>
      <h3>${r.title}</h3>
      ${r.fish
        ? `<div class="stat gold-text">${r.fish[r.field]} ${r.unit}</div>
           <strong>${r.fish.name}</strong>
           <p class="muted">${r.fish.location||"Unbekanntes Gebiet"}</p>`
        : '<div class="empty">Noch kein Rekord vorhanden.</div>'}
    </div>
  `).join("");
}

/* =========================================================
   FISCHLEXIKON
========================================================= */

function renderEncyclopedia() {
  $("fishCards").innerHTML=fishData.map(f=>{
    const discovered=state.catches.some(c=>c.name===f.name);
    return `
      <div class="card">
        <div class="row between">
          <span class="tag">${f.type}</span>
          <span class="muted">${discovered?"Entdeckt":"Noch nicht gefangen"}</span>
        </div>
        <h3>🐟 ${f.name}</h3>
        <p class="muted">${f.habitat}</p>
        <hr>
        <p><strong>Größe:</strong> ${f.length[0]}–${f.length[1]} cm</p>
        <p><strong>Gewicht:</strong> ${f.weight[0]}–${f.weight[1]} kg</p>
        <p><strong>Nahrung:</strong> ${f.food}</p>
        <p><strong>Geeignete Köder:</strong> ${f.baits.join(", ")}</p>
        <p><strong>Aktiv:</strong> ${f.times.join(", ")}</p>
        <p><strong>Seltenheit:</strong> ${"★".repeat(Math.min(5,f.rarity))}</p>
      </div>
    `;
  }).join("");
}

/* =========================================================
   TURNIERE
========================================================= */

const tournamentDefinitions=[
  {
    id:"heavy",
    name:"Schwerster Fang",
    description:"Fange während des Turniers den schwersten Fisch.",
    requirement:"Gewicht entscheidet",
    reward:350
  },
  {
    id:"carpCup",
    name:"Karpfen-Cup",
    description:"Der schwerste Karpfen gewinnt.",
    requirement:"Nur Karpfen zählen",
    reward:500
  },
  {
    id:"speciesCup",
    name:"Arten-Challenge",
    description:"Fange möglichst viele verschiedene Fischarten.",
    requirement:"Artenvielfalt entscheidet",
    reward:400
  }
];

function renderTournaments() {
  $("tournamentCards").innerHTML=tournamentDefinitions.map(t=>`
    <div class="card">
      <span class="tag">ANGELWETTBEWERB</span>
      <h3>${t.name}</h3>
      <p class="muted">${t.description}</p>
      <p><strong>Regel:</strong> ${t.requirement}</p>
      <p><strong>Preisgeld:</strong> ${t.reward} €</p>
      <button class="primary" onclick="enterTournament('${t.id}')">Ergebnis prüfen</button>
    </div>
  `).join("");
}

function enterTournament(id) {
  const tournament=tournamentDefinitions.find(t=>t.id===id);
  if(!tournament) return;

  let score=0;
  let description="Noch kein gültiger Fang.";

  if(id==="heavy"&&state.catches.length) {
    const best=state.catches.reduce((a,b)=>a.weight>b.weight?a:b);
    score=best.weight;
    description=`Dein bester Fang: ${best.name} (${best.weight} kg).`;
  }

  if(id==="carpCup") {
    const carps=state.catches.filter(f=>f.name.toLowerCase().includes("karpfen"));
    if(carps.length) {
      const best=carps.reduce((a,b)=>a.weight>b.weight?a:b);
      score=best.weight;
      description=`Dein bester Karpfen: ${best.weight} kg.`;
    }
  }

  if(id==="speciesCup") {
    score=new Set(state.catches.map(f=>f.name)).size;
    description=`Du hast ${score} unterschiedliche Fischarten gefangen.`;
  }

  showModal(tournament.name,`
    <p>${description}</p>
    <p>Dein aktueller Wert: <strong>${score}</strong></p>
    <p class="muted">Das Turnier ist hier als persönlicher Ergebnisvergleich umgesetzt. Es gibt keine Online-Rangliste.</p>
  `);
}

/* =========================================================
   EVENTS UND BESONDERE FÄNGE
========================================================= */

const events=[
  "Karpfen-Aktivität",
  "Besonders aktive Fischschwärme",
  "Forellen-Saison",
  "Nachtangel-Event",
  "Seltene Fangmöglichkeiten"
];

function rotateEvent() {
  const event=events[Math.floor(Math.random()*events.length)];
  $("eventTag").textContent=event;
}

setInterval(rotateEvent,90000);

/* =========================================================
   LEVEL UND RANG
========================================================= */

function getAnglerRank() {
  if(state.level>=30) return "Angellegende";
  if(state.level>=20) return "Meisterangler";
  if(state.level>=15) return "Profiangler";
  if(state.level>=10) return "Fortgeschrittener Angler";
  if(state.level>=5) return "Hobbyangler";
  return "Anfänger";
}

function updateRankDisplay() {
  const rank=getAnglerRank();
  $("eventTag").title="Dein Rang: "+rank;
}

/* =========================================================
   SPEICHERN UND WIEDERHERSTELLEN
========================================================= */

function safeSave() {
  try {
    saveGame();
  } catch(error) {
    console.error("Speichern fehlgeschlagen:",error);
    notify("Speichern fehlgeschlagen. Prüfe den Browser-Speicher.");
  }
}

window.addEventListener("beforeunload",safeSave);

checkMissionReset();
updateRankDisplay();
renderMissions();
renderLogbook();
renderRecords();
renderEncyclopedia();
renderTournaments();
</script>

